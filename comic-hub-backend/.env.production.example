NODE_ENV="production"
PORT=4000
APP_VERSION="local"

DATABASE_URL="postgresql://postgres:YOUR_STRONG_PASSWORD@postgres:5432/manga_db?schema=public"
REDIS_URL="redis://redis:6379"

JWT_ACCESS_SECRET="CHANGE_ME_STRONG_ACCESS_SECRET_AT_LEAST_32_CHARS"
JWT_REFRESH_SECRET="CHANGE_ME_STRONG_REFRESH_SECRET_AT_LEAST_32_CHARS"

FRONTEND_URL="https://your-domain.com"
CORS_ORIGINS="https://your-domain.com"
APP_URL="https://your-domain.com"

MAIL_HOST=""
MAIL_PORT=587
MAIL_USER=""
MAIL_PASSWORD=""
MAIL_FROM="Manga Platform <no-reply@your-domain.com>"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
EMAIL_VERIFY_TOKEN_EXPIRES_MINUTES=60
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=30

TOKEN_BUCKET_CAPACITY=10
TOKEN_BUCKET_REFILL_RATE=1
TOKEN_BUCKET_REFILL_INTERVAL_MS=1000
TOKEN_BUCKET_COST=1
VIEW_DEDUPE_TTL_SECONDS=3600

S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""
S3_FORCE_PATH_STYLE="true"
S3_SIGNED_READ_EXPIRES_SECONDS=300
S3_PRIVATE_BUCKET_MODE="false"

PAYOS_CLIENT_ID=""
PAYOS_API_KEY=""
PAYOS_CHECKSUM_KEY=""
