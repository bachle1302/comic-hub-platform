# Dependencies
node_modules/
**/node_modules/

# Build outputs
dist/
**/dist/
build/
**/build/
.next/
**/.next/
out/
**/out/
coverage/
**/coverage/

# Logs
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Env files - DO NOT COMMIT REAL SECRETS
.env
.env.local
.env.production
.env.development
.env.test
.env.staging
.env.*.local

comic-hub-backend/.env
comic-hub-backend/.env.local
comic-hub-backend/.env.production
comic-hub-backend/.env.development
comic-hub-backend/.env.test
comic-hub-backend/.env.staging
comic-hub-backend/.env.*.local

fe/.env
fe/.env.local
fe/.env.production
fe/.env.development
fe/.env.test
fe/.env.staging
fe/.env.*.local

manga-crawler/.env
manga-crawler/.env.local
manga-crawler/.env.production
manga-crawler/.env.*.local

# Allow example env files
!.env.example
!comic-hub-backend/.env.example
!comic-hub-backend/.env.production.example
!fe/.env.local.example
!fe/.env.production.example
!manga-crawler/.env.example

# Database backups
backups/*
!backups/.gitkeep
*.sql
*.dump
*.backup
*.bak

# Keep Prisma migrations tracked even though they contain .sql files
!**/prisma/migrations/
!**/prisma/migrations/**

# Uploaded/crawled/generated data
uploads/
**/uploads/
tmp/
**/tmp/
temp/
**/temp/
.cache/
**/.cache/

manga-crawler/data/
manga-crawler/output/
manga-crawler/downloads/
manga-crawler/images/
manga-crawler/tmp/
manga-crawler/cache/
manga-crawler/manga-storage/
*.result.json
chapter_result.json

# Secrets / certificates / keys
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.jks
*.keystore
id_rsa
id_dsa
*.secret
secrets/
**/secrets/

# Docker local volumes
docker-data/
postgres-data/
redis-data/
minio-data/

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# Runtime
*.pid
*.seed
*.pid.lock
